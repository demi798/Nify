# Nify 环境变量示例（复制为 .env 后修改）
# 前缀均为 NIFY_

# ---------- 服务 ----------
NIFY_SERVER_HOST=0.0.0.0
NIFY_SERVER_PORT=8080

# ---------- MySQL ----------
NIFY_MYSQL_HOST=127.0.0.1
NIFY_MYSQL_PORT=3306
NIFY_MYSQL_USER=nify
NIFY_MYSQL_PASSWORD=nify
NIFY_MYSQL_DATABASE=nify
NIFY_MYSQL_CHARSET=utf8mb4
NIFY_MYSQL_POOL_SIZE=10
NIFY_MYSQL_MAX_OVERFLOW=20
NIFY_MYSQL_POOL_RECYCLE=3600
NIFY_MYSQL_ECHO=false

# ---------- Redis ----------
NIFY_REDIS_HOST=127.0.0.1
NIFY_REDIS_PORT=6379
NIFY_REDIS_DB=0
# NIFY_REDIS_PASSWORD=
NIFY_REDIS_KEY_PREFIX=nify:

# ---------- 安全 ----------
NIFY_SECRET_KEY=nify-dev-secret-change-me-32bytes!!
NIFY_JWT_ALGORITHM=HS256
NIFY_JWT_EXPIRE_MINUTES=10080

# ---------- 演示账号（启动幂等写入；生产请 NIFY_SEED_DEMO_ACCOUNT=false）----------
NIFY_SEED_DEMO_ACCOUNT=true
NIFY_DEMO_EMAIL=demo@nify.local
NIFY_DEMO_PASSWORD=Demo1234!
NIFY_DEMO_DISPLAY_NAME=演示用户
NIFY_DEMO_WORKSPACE_NAME=演示工作区

# ---------- 日志 ----------
NIFY_LOG_LEVEL=INFO
NIFY_LOG_JSON=false

# ---------- LLM Gateway ----------
NIFY_LLM_GLOBAL_CONCURRENCY=25
NIFY_LLM_PROVIDER_CONCURRENCY=15
NIFY_LLM_WORKSPACE_CONCURRENCY=10
NIFY_LLM_MAX_CONCURRENCY=50
NIFY_LLM_CONNECT_TIMEOUT_SEC=10
NIFY_LLM_TTFT_TIMEOUT_SEC=30
NIFY_LLM_IDLE_TIMEOUT_SEC=60
NIFY_LLM_TOTAL_TIMEOUT_SEC=300
NIFY_LLM_MAX_RETRIES=3

# ---------- Provider 健康巡检（每分钟连通性测试）----------
NIFY_PROVIDER_HEALTH_ENABLED=true
NIFY_PROVIDER_HEALTH_INTERVAL_SEC=60
NIFY_PROVIDER_HEALTH_FAIL_THRESHOLD=3
# 运行时凭证短缓存 TTL（秒）；0=关闭。改 api_key 会主动失效。
NIFY_PROVIDER_RUNTIME_CACHE_TTL_SEC=30

# ---------- Files / Milvus / Worker ----------
NIFY_STORAGE_ROOT=./data/files
NIFY_MILVUS_HOST=127.0.0.1
NIFY_MILVUS_PORT=19530
NIFY_MILVUS_COLLECTION=nify_chunks
NIFY_MILVUS_EMBEDDING_DIM=1536
NIFY_MILVUS_ENABLED=false
# Embedding：复用 Provider 凭证；可指定 provider id，或留空自动选择
NIFY_EMBEDDING_MODEL_KEY=text-embedding-v3
# NIFY_EMBEDDING_PROVIDER_ID=
NIFY_WORKER_POLL_TIMEOUT_SEC=5
NIFY_WORKER_QUEUES=queue:document_parse

# ---------- ORM 插件（对应 MyBatis-Plus：分页 / 自动填充 / 逻辑删除）----------
NIFY_PAGE_DEFAULT_LIMIT=20
NIFY_PAGE_MAX_LIMIT=100
NIFY_PAGE_MAX_OFFSET_WINDOW=1000
NIFY_ORM_LOGIC_DELETE_ENABLED=true
NIFY_ORM_LOGIC_DELETE_FIELD=deleted_at
NIFY_ORM_CREATE_TIME_FIELD=created_at
NIFY_ORM_UPDATE_TIME_FIELD=updated_at
NIFY_ORM_AUTOFILL_ENABLED=true
