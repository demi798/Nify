# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 环境与密钥（保留 *.example）----------
.env
.env.*
!.env.example
!**/.env.example

# ---------- 启动脚本产生的 PID / 旧日志路径 ----------
.nify-*.pid
.nify-*.log

# ---------- 打包与本地产物 ----------
dist/
*.tar.gz
!.gitkeep

# ---------- 后端 Python ----------
backend/.venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/**/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/data/
backend/log/*.log
!backend/log/.gitkeep

# ---------- 前端 Node / Vite ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# ---------- 杂项 ----------
*.log
.cache/
tmp/
temp/
